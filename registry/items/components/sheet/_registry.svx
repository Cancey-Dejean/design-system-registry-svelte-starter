    target: "~/components/sheet/sheet-overlay.svelte"
  - path: registry/items/components/sheet/sheet-content.svelte
    type: registry:ui
    target: "~/components/sheet/sheet-content.svelte"
  - path: registry/items/components/sheet/sheet-header.svelte
    type: registry:ui
    target: "~/components/sheet/sheet-header.svelte"
  - path: registry/items/components/sheet/sheet-footer.svelte
