  - bits-ui
files:
  - path: registry/items/components/avatar/index.ts
    type: registry:ui
    target: '~/components/avatar/index.ts'
  - path: registry/items/components/avatar/avatar.svelte
    type: registry:ui
    target: '~/components/avatar/avatar.svelte'
  - path: registry/items/components/avatar/avatar-image.svelte
    type: registry:ui
    target: '~/components/avatar/avatar-image.svelte'
  - path: registry/items/components/avatar/avatar-fallback.svelte
    type: registry:ui
    target: '~/components/avatar/avatar-fallback.svelte'
  - path: registry/items/components/avatar/avatar-badge.svelte
    type: registry:ui
    target: '~/components/avatar/avatar-badge.svelte'
  - path: registry/items/components/avatar/avatar-group.svelte
    type: registry:ui
    target: '~/components/avatar/avatar-group.svelte'
  - path: registry/items/components/avatar/avatar-group-count.svelte
    type: registry:ui
    target: '~/components/avatar/avatar-group-count.svelte'
---

Use avatar for profile images with initials fallback. Set `size` to `sm`, `default`, or `lg`.
Compose with `Avatar.Badge`, `Avatar.Group`, and `Avatar.GroupCount` for status and stacks.

```svelte
<script lang="ts">
	import * as Avatar from '~/components/avatar';
</script>

<Avatar.Root>
	<Avatar.Image src="https://github.com/shadcn.png" alt="@shadcn" />
	<Avatar.Fallback>CN</Avatar.Fallback>
</Avatar.Root>
```
