---
name: datepicker
type: registry:ui
title: Date Picker
description: A date picker built from Popover and Calendar, with optional range and presets.
dependencies:
  - '@internationalized/date'
  - '@lucide/svelte'
registryDependencies:
  - popover
  - calendar
  - button
  - label
files:
  - path: registry/items/components/datepicker/datepicker.svelte
    type: registry:ui
    target: '~/components/datepicker/datepicker.svelte'
---

Date picker composes **Popover**, **Calendar**, **Button**, and **Label**. Install those primitives
(and **range-calendar** when you need ranges), then use or adapt this example.

```svelte
<script lang="ts">
	import DatePicker from '~/components/datepicker/datepicker.svelte';
</script>

<DatePicker label="Date of birth" />
```

Custom composition:

```svelte
<script lang="ts">
	import ChevronDownIcon from '@lucide/svelte/icons/chevron-down';
	import { getLocalTimeZone, today, type CalendarDate } from '@internationalized/date';
	import Button from '~/components/button/button.svelte';
	import { Calendar } from '~/components/calendar';
	import { Label } from '~/components/label';
	import * as Popover from '~/components/popover';

	let open = $state(false);
	let value = $state<CalendarDate | undefined>();
</script>

<div class="flex flex-col gap-3">
	<Label for="date">Date of birth</Label>
	<Popover.Root bind:open>
		<Popover.Trigger id="date">
			{#snippet child({ props })}
				<Button {...props} variant="outline" class="w-48 justify-between font-normal">
					{value ? value.toDate(getLocalTimeZone()).toLocaleDateString() : 'Select date'}
					<ChevronDownIcon />
				</Button>
			{/snippet}
		</Popover.Trigger>
		<Popover.Content class="w-auto overflow-hidden p-0" align="start">
			<Calendar
				type="single"
				bind:value
				captionLayout="dropdown"
				onValueChange={() => {
					open = false;
				}}
				maxValue={today(getLocalTimeZone())}
			/>
		</Popover.Content>
	</Popover.Root>
</div>
```
