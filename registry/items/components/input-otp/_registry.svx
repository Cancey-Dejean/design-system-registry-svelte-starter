description: Accessible one-time password component with copy paste functionality.
dependencies:
  - bits-ui
  - '@lucide/svelte'
files:
  - path: registry/items/components/input-otp/index.ts
    type: registry:ui
    target: '~/components/input-otp/index.ts'
  - path: registry/items/components/input-otp/input-otp.svelte
    type: registry:ui
    target: '~/components/input-otp/input-otp.svelte'
  - path: registry/items/components/input-otp/input-otp-group.svelte
    type: registry:ui
    target: '~/components/input-otp/input-otp-group.svelte'
  - path: registry/items/components/input-otp/input-otp-slot.svelte
