---
name: popover
type: registry:ui
title: Popover
description: Displays rich content in a portal, triggered by a button.
dependencies:
  - bits-ui
registryDependencies:
  - button
files:
  - path: registry/items/components/popover/index.ts
    type: registry:ui
    target: "~/components/popover/index.ts"
  - path: registry/items/components/popover/popover.svelte
    type: registry:ui
    target: "~/components/popover/popover.svelte"
  - path: registry/items/components/popover/popover-trigger.svelte
    type: registry:ui
    target: "~/components/popover/popover-trigger.svelte"
  - path: registry/items/components/popover/popover-portal.svelte
    type: registry:ui
    target: "~/components/popover/popover-portal.svelte"
  - path: registry/items/components/popover/popover-content.svelte
    type: registry:ui
    target: "~/components/popover/popover-content.svelte"
  - path: registry/items/components/popover/popover-close.svelte
    type: registry:ui
    target: "~/components/popover/popover-close.svelte"
---

Use popover for non-modal floating content. Compose `Popover.Root` with `Trigger` and `Content`.

```svelte
<script lang="ts">
	import * as Popover from '~/components/popover';
	import { buttonVariants } from '~/components/button';
</script>

<Popover.Root>
	<Popover.Trigger class={buttonVariants({ variant: 'outline' })}>Open popover</Popover.Trigger>
	<Popover.Content class="w-80">
		<div class="grid gap-4">
			<div class="space-y-2">
				<h4 class="leading-none font-medium">Dimensions</h4>
				<p class="text-muted-foreground text-sm">Set the dimensions for the layer.</p>
			</div>
		</div>
	</Popover.Content>
</Popover.Root>
```
