    type: registry:ui
    target: '~/components/command/command-dialog.svelte'
  - path: registry/items/components/command/command-input.svelte
    type: registry:ui
    target: '~/components/command/command-input.svelte'
  - path: registry/items/components/command/command-list.svelte
    type: registry:ui
    target: '~/components/command/command-list.svelte'
  - path: registry/items/components/command/command-empty.svelte
    type: registry:ui
    target: '~/components/command/command-empty.svelte'
  - path: registry/items/components/command/command-group.svelte
    type: registry:ui
    target: '~/components/command/command-group.svelte'
  - path: registry/items/components/command/command-item.svelte
    type: registry:ui
    target: '~/components/command/command-item.svelte'
  - path: registry/items/components/command/command-link-item.svelte
    type: registry:ui
    target: '~/components/command/command-link-item.svelte'
  - path: registry/items/components/command/command-separator.svelte
