{
  "name": "design-system-registry-svelte-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,storybook -c cyan,magenta \"vp dev\" \"storybook dev -p 6006\"",
    "build": "bun run registry:build && vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "registry:generate": "bun run scripts/generate-registry-json.ts",
    "registry:doctor": "bun run scripts/doctor.ts",
    "registry:build": "bun run registry:generate && shadcn-svelte registry build registry.generated.json --output static/r"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@tanstack/svelte-table": "^9.2.4",
    "chrono-node": "^2.10.1",
    "embla-carousel-svelte": "^8.6.0",
    "github-slugger": "^2.0.0",
    "layerchart": "^2.5.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "shiki": "^4.4.3",
    "svelte-sonner": "^1.2.1",
    "vaul-svelte": "1.0.0-next.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.47.0",
    "@shadcn/lint": "^0.2.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-svelte-csf": "latest",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/sveltekit": "^10.6.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "bits-ui": "^2.18.0",
    "cn": "^0.4.0",
    "concurrently": "^10.0.5",
    "fast-check": "^4.10.2",
    "gray-matter": "^4.0.3",
    "mdsvex": "^0.12.8",
    "playwright": "latest",
    "rehype-slug": "^6.0.0",
    "shadcn-svelte": "^1.7.0",
    "storybook": "^10.6.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vite-plus": "0.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
