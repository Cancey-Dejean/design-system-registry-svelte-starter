{
  "name": "design-system-registry-svelte-starter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,storybook -c cyan,magenta \"vp dev\" \"storybook dev -p 6006\"",
    "build": "bun run registry:build && vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "registry:generate": "bun run scripts/generate-registry-json.ts",
    "registry:doctor": "bun run scripts/doctor.ts",
    "registry:build": "bun run registry:generate && shadcn-svelte registry build registry.generated.json --output static/r"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@tanstack/svelte-table": "^9.3.2",
    "@xyflow/svelte": "^1.7.0",
    "chrono-node": "^2.10.3",
    "d3-scale": "^4.0.3",
    "embla-carousel-svelte": "^8.6.0",
    "github-slugger": "^2.0.0",
    "layerchart": "^2.11.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "shiki": "^4.6.0",
    "svelte-sonner": "^1.2.3",
    "vaul-svelte": "1.0.0-next.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.75.0",
    "@shadcn/lint": "^0.2.5",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/svelte": "^10.6.7",
    "@storybook/sveltekit": "^10.6.7",
    "@sveltejs/adapter-vercel": "^7.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "bits-ui": "^2.21.0",
    "cn": "^0.5.2",
    "concurrently": "^10.0.7",
    "esrap": "^2.4.2",
    "fast-check": "^4.10.3",
    "gray-matter": "^4.0.3",
    "mdsvex": "^0.12.8",
    "playwright": "^1.65.1",
    "rehype-slug": "^6.0.0",
    "shadcn-svelte": "^1.8.1",
    "storybook": "^10.6.7",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.7.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.7",
    "source-map-js": "1.2.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.11.0"
  }
}
